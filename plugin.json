{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "better-search",
  "version": "0.8.0",
  "description": "Fast, private search across your local Codex chats.",
  "keywords": [
    "codex",
    "local",
    "search",
    "chat-history",
    "embeddings"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "BetterSearch",
        "shortDescription": "Private search for Codex chats",
        "longDescription": "Search your local Codex chats from a focused conversation panel or directly through agent tools. Embeddings and the index stay on your computer.",
        "developerName": "BetterSearch contributors",
        "category": "Productivity",
        "capabilities": [
          "Interactive",
          "Read"
        ],
        "logo": "./assets/better-search-tab-light.png",
        "composerIcon": "./assets/better-search-tab-light.png",
        "brandColor": "#181818",
        "brandColorDark": "#B8EE97",
        "defaultPrompt": "Search my local Codex chats for a previous discussion.",
        "logoDark": "./assets/better-search-tab-dark.png",
        "composerIconDark": "./assets/better-search-tab-dark.png"
      }
    }
  },
  "license": "MIT"
}
