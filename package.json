{
  "name": "better-search",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Private local search for Codex chats, with a conversation panel and headless agent tools",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build": "node scripts/build.mjs",
    "start": "node dist/launcher.js",
    "stop": "node scripts/stop.mjs",
    "status": "node scripts/status.mjs",
    "mcp": "node dist/mcp.js",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package.mjs",
    "build:native:gpu": "node scripts/build-native.mjs --gpu",
    "verify:release": "node scripts/verify-release.mjs",
    "build:native:cuda": "node scripts/build-native.mjs --cuda",
    "build:cuda": "node scripts/build.mjs --cuda",
    "stage:local": "node scripts/package.mjs --local"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "linkedom": "^0.18.14",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "license": "MIT"
}
